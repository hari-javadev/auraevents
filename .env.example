# ============================================================
# AURA EVENTS - Environment Variables (.env.example)
# ============================================================
# Copy this file to .env and insert your Gmail App Password
# NEVER commit your actual .env file or credentials to Git!
# ============================================================

# Backend Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Configuration
# Use your Google Account 16-character App Password (not your normal Gmail login password)
# How to get an App Password:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an app named "AURA EVENTS" and copy the 16-character password into SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=auraevents321@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
SMTP_FROM="AURA EVENTS" <auraevents321@gmail.com>

# Business Email to receive customer quote enquiry notifications
BUSINESS_EMAIL=auraevents321@gmail.com
